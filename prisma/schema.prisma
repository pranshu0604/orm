generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  name      String?
  image     String?
  createdAt DateTime @default(now())

  // Onboarding fields
  role                String? // One-word description (e.g., "Developer", "Creator")
  aspiration          String? // Detailed info about goals
  targetCloudVolume   String? // Target clout volume
  onboardingCompleted Boolean @default(false)

  // Subscription & Credits
  tier             UserTier @default(FREE)
  creditsRemaining Int      @default(0) // Available credits for AI operations

  // Relations
  platforms       PlatformConnection[]
  reports         PerformanceReport[]
  suggestions     ContentSuggestion[]
  creditPurchases CreditPurchase[]
  usageHistory    UsageHistory[]
}

model PlatformConnection {
  id           String       @id @default(cuid())
  user         User         @relation(fields: [userId], references: [id])
  userId       String
  platform     PlatformType
  profileId    String // Platform's unique user ID (essential)
  username     String? // Store username fetched during connection (optional)
  accessToken  String? // Encrypted, store only if needed for future API calls
  refreshToken String? // Encrypted, store only if needed (e.g., GitHub for specific actions)
  scopes       String? // Scopes granted during OAuth
  expiresAt    DateTime? // Access token expiry time (less relevant if not using token)
  connectedAt  DateTime     @default(now())

  // Platform-specific configuration
  platformRole       String? // One-word description for this platform
  platformAspiration String? // Detailed info for this platform
  targetTier         TargetTier @default(BEGINNER)
  setupCompleted     Boolean    @default(false)

  // Relations
  posts       Post[]
  reports     PerformanceReport[]
  suggestions ContentSuggestion[]

  @@unique([userId, platform])
}

enum PlatformType {
  X
  GITHUB
  // add linkedin and insta later
}

enum UserTier {
  FREE
  PAID
}

enum TargetTier {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

model Post {
  id             String             @id @default(cuid())
  platformConn   PlatformConnection @relation(fields: [platformConnId], references: [id])
  platformConnId String
  postId         String // actual platform post ID
  url            String
  content        String?
  postedAt       DateTime

  // Post metadata (Twitter/X specific)
  isPinned       Boolean? @default(false)
  isRetweet      Boolean? @default(false)
  isQuote        Boolean? @default(false)
  hasMedia       Boolean? @default(false)
  mediaUrls      String[] // Array of image/video URLs
  videoDuration  String? // For videos (e.g., "1:23")

  metrics        Metric?            @relation(name: "PostMetric")
  sentiment      Sentiment?         @relation(name: "PostSentiment")

  @@unique([platformConnId, postId])
}

model Metric {
  id            String @id @default(cuid())
  post          Post   @relation(name: "PostMetric", fields: [postId], references: [id])
  postId        String @unique
  likes         Int?
  comments      Int?
  shares        Int?
  views         Int?
  stars         Int?
  profileClicks Int?
}

model Sentiment {
  id       String   @id @default(cuid())
  post     Post     @relation(name: "PostSentiment", fields: [postId], references: [id])
  postId   String   @unique
  score    Float
  label    String
  keywords String[]
}

model PerformanceReport {
  id                   String             @id @default(cuid())
  user                 User               @relation(fields: [userId], references: [id])
  userId               String
  platformConnection   PlatformConnection @relation(fields: [platformConnectionId], references: [id])
  platformConnectionId String
  generatedAt          DateTime           @default(now())

  // Report content (JSON stored as String)
  content String // Full report with metrics, sentiment, relevance
  score   Int // Overall score relative to target tier

  // Metrics (platform-specific)
  metrics Json? // Flexible JSON for platform-specific metrics

  // For context in future reports
  includedInContext Boolean @default(true)

  @@index([userId, generatedAt])
  @@index([platformConnectionId, generatedAt])
}

model ContentSuggestion {
  id                   String             @id @default(cuid())
  user                 User               @relation(fields: [userId], references: [id])
  userId               String
  platformConnection   PlatformConnection @relation(fields: [platformConnectionId], references: [id])
  platformConnectionId String
  generatedAt          DateTime           @default(now())

  // Suggestion type
  suggestionType SuggestionType

  // Suggestion content (JSON stored as String)
  content String // Bio, Tweets, Volume, Following, Replies, Commits, PRs, Issues

  // Custom prompt (for paid users)
  customPrompt String?

  // Whether this was based on a performance report
  basedOnReportId String?

  // For context in future suggestions
  includedInContext Boolean @default(true)

  @@index([userId, generatedAt])
  @@index([platformConnectionId, generatedAt])
}

model CreditPurchase {
  id            String   @id @default(cuid())
  user          User     @relation(fields: [userId], references: [id])
  userId        String
  purchasedAt   DateTime @default(now())
  creditsAmount Int // Number of credits purchased
  priceInCents  Int // Price paid in cents
  paymentId     String? // External payment processor ID

  @@index([userId, purchasedAt])
}

model UsageHistory {
  id          String    @id @default(cuid())
  user        User      @relation(fields: [userId], references: [id])
  userId      String
  usageType   UsageType
  creditsUsed Int // Number of credits consumed
  successful  Boolean // Only successful operations count toward limits
  createdAt   DateTime  @default(now())

  // Metadata
  platformType PlatformType?
  errorMessage String? // If unsuccessful, why

  @@index([userId, createdAt])
  @@index([userId, usageType, successful])
}

enum SuggestionType {
  BIO
  TWEET
  VOLUME
  FOLLOWING
  REPLY
  COMMIT
  PR
  ISSUE
}

enum UsageType {
  PERFORMANCE_REPORT
  CONTENT_SUGGESTION
  CUSTOM_PROMPT
}

model Waitlist {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())

  @@index([createdAt])
}
