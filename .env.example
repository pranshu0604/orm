# Node.js 22.x. Copy to .env for local development.
# Use a dedicated personal Preview database. The direct URL is for Prisma migration commands.
DATABASE_URL=
DIRECT_DATABASE_URL=

# Personal Clerk app; only this account's user ID can link platforms or generate reports.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
DEMO_OWNER_CLERK_USER_ID=
# Optional: required only if a Clerk webhook is explicitly configured.
CLERK_WEBHOOK_SECRET=

# Server-only. Use the same randomly generated AI_SERVICE_TOKEN in FastAPI.
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_TOKEN=

# Personal GitHub OAuth App. Callback: <NEXTAUTH_URL>/api/auth/callback/github.
DEMO_OWNER_GITHUB_LOGIN=pranshu0604
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Optional and local development only: X OAuth and Nitter instance caching.
TWITTER_API_KEY=
TWITTER_API_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: keep off for the portfolio preview.
NEXT_PUBLIC_WAITLIST_ENABLED=false
