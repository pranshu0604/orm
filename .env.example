# Environment variables for PRAN (Public Reputation and Analysis Node)

# Node environment
# Set to 'development' for local development (enables Playwright for Nitter scraping)
# In production (Vercel), this will be set to 'production' automatically
NODE_ENV=development

# Database connection
DIRECT_DATABASE_URL=""
DATABASE_URL=""

# Authentication - Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# API Keys / Service URLs
# The project now uses a separate FastAPI-based AI microservice located at `../ai`.
# Set this to the AI microservice base URL (for local dev: http://localhost:8000)
AI_SERVICE_URL="http://localhost:8000"
AI_SERVICE_TOKEN=""
# Clerk user id whose latest stored report/suggestions the public /demo page shows.
# Leave empty to serve the labelled sample data.
DEMO_OWNER_CLERK_USER_ID=""

# Twitter/X OAuth
TWITTER_API_KEY=""
TWITTER_API_SECRET=""

# Security
ENCRYPTION_SECRET_KEY=""

# NextAuth
NEXTAUTH_URL=""
NEXTAUTH_SECRET=""

# Redis (Nitter instance cache and the AI warm-up throttle; optional, falls back to in-memory)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Clerk webhook / networkless verification (optional)
CLERK_WEBHOOK_SECRET=""
CLERK_JWT_KEY=""

# Email digests (scripts/send-digests.ts)
RESEND_API_KEY=""
